<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#AA000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:text="⚠️ App Detected. Take a breath."
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:gravity="center" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

    <Button
        android:text="Dismiss"
        android:layout_marginTop="20dp"
        android:onClick="dismissOverlay" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

</LinearLayout>